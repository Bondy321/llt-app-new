rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private media is session-authorised by Cloud Functions. Stable identity
    // claims are never sufficient to address Storage objects directly.
    match /private_tour_photos/{tourId}/{ownerId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Group media is server-mediated. Storage rules cannot query Realtime
    // Database tour membership, so clients must never address these objects
    // directly. Cloud Functions verify current membership/assignment for every
    // upload, read-URL resolution, and delete request; Admin SDK and signed URL
    // operations bypass these client rules.
    match /group_tour_photos/{tourId}/{fileName} {
      allow read, write: if false;
    }

    match /group_tour_photos/{tourId}/viewers/{fileName} {
      allow read, write: if false;
    }

    match /group_tour_photos/{tourId}/thumbnails/{fileName} {
      allow read, write: if false;
    }
  }
}
