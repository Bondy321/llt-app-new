{
  "cli": {
    "version": "22.6.0",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "env": {
        "EXPO_PUBLIC_DRIVER_TOUR_PACK_TESTFLIGHT": "false"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development"
    },
    "development-device": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "env": {
        "EXPO_PUBLIC_VERIFY_PASSENGER_LOGIN_USE_APPCHECK": "true",
        "EXPO_PUBLIC_VERIFY_PASSENGER_LOGIN_REQUIRE_APPCHECK": "true",
        "LLT_REQUIRE_PRODUCTION_APPCHECK": "true",
        "EXPO_PUBLIC_PASSENGER_TRIP_ENABLED": "true"
      },
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "environment": "production",
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_DRIVER_TOUR_PACK_TESTFLIGHT": "false",
        "EXPO_PUBLIC_PASSENGER_TRIP_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.lochlomondtravel.tourapp"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      }
    }
  }
}
