{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:photo-variants": "node scripts/backfillPhotoVariants.js",
    "harden:private-photos": "node scripts/hardenPrivatePhotoMedia.js",
    "harden:group-photos": "node scripts/hardenGroupPhotoMedia.js",
    "backfill:tour-date-indexes": "node scripts/backfillTourDateIndexes.js",
    "backfill:driver-tour-pack-issues": "node scripts/backfillDriverTourPackIssueProjections.js",
    "repair:manifest-duplicates": "node scripts/repairDuplicateManifestPassengers.js",
    "migrate:opaque-passenger-identities": "node scripts/migrateOpaquePassengerIdentities.js",
    "migrate:app-sessions": "node scripts/migrateAppSessions.js",
    "migrate:notification-devices": "node scripts/migrateNotificationDevices.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "expo-server-sdk": "^4.0.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "overrides": {
    "@google-cloud/storage": {
      "uuid": "^11.1.1"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
