# Cloud Functions runtime configuration (no secrets in this file).
# App Check is explicitly disabled until the production apps are registered.
# Omit either setting in a deployed runtime to fail closed against accidental
# configuration loss; change it to true only during an approved staged rollout.
REQUIRE_APP_CHECK_FOR_LOGIN=false
REQUIRE_APP_CHECK_FOR_GROUP_MEDIA=false

# Account deletion has no environment-controlled phase switch. Compatibility policy is the private,
# exact-schema RTDB record at account_deletion_rollout/v1. Missing means compatibility, malformed
# fails closed, and server_only is reserved for a separately approved cutover.
# Its request/status/retry endpoints reuse the existing group-media/session App Check gate above; do
# not introduce a looser account-deletion-only override.
